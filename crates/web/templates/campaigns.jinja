{% extends "base.jinja" %} {% block title %}Campaigns — {{ site.name }}{%
endblock %} {% block content %}
<div class="page-head">
  <div>
    <h1 class="page-title" style="view-transition-name: s-{{ site.id }}">
      {{ site.name }}
    </h1>
    <p class="page-sub">{{ site.domain }} · UTM campaigns</p>
  </div>
  {% if sites %}
  <form method="get" action="{{ scope_path }}">
    <select name="site" onchange="this.form.submit()" aria-label="Filter by site">
      {% for s in sites %}<option value="{{ s.id }}" {% if s.id == site.id %}selected{% endif %}>{{ s.name }}</option>{% endfor %}
    </select>
  </form>
  {% endif %}
</div>

<div class="tabs">
  <a href="/app/sites/{{ site.id }}?range={{ range }}">Overview</a>
  <a href="/app/campaigns?site={{ site.id }}&range={{ range }}" class="active">Campaigns</a>
  <a href="/app/retention?site={{ site.id }}&range={{ range }}">Retention</a>
  <a href="/app/paths?site={{ site.id }}&range={{ range }}">Paths</a>
</div>

<div class="grid-2">
  {% for r in reports %}
  <div class="card">
    <div class="section-header"><h2>{{ r.title }} · {{ range }}</h2></div>
    <table>
      <thead>
        <tr>
          <th>{{ r.title }}</th>
          <th>Visitors</th>
          <th>%</th>
        </tr>
      </thead>
      <tbody>
        {% for row in r.rows %}
        <tr>
          <td class="cell-truncate">{{ row.value }}</td>
          <td>{{ row.sessions }}</td>
          <td>
            <div class="bar-cell">
              <div class="bar" style="--w:{{ [row.pct, 100] | min }}%"></div>
              {{ "%.1f" | format(row.pct) }}%
            </div>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3" class="empty-cell">No data</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
</div>
{% endblock %}
