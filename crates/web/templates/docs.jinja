{% extends "base.jinja" %}
{% block title %}Docs{% endblock %}
{% block content %}
<div class="page-head">
  <h1 class="page-title">Documentation</h1>
  <p class="page-sub">
    Also available as Markdown for LLM agents at
    <a href="/llms.txt"><code>/llms.txt</code></a>.
  </p>
</div>

<div class="doc-layout">
  <div class="card">
    <article class="doc-prose">{{ content | safe }}</article>
  </div>

  {% if toc %}
  <aside class="doc-toc">
    <nav aria-label="On this page">
      <span class="side-label">On this page</span>
      <ul>
        {% for item in toc %}
        <li class="toc-l{{ item.level }}"><a href="#{{ item.slug }}">{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </aside>
  {% endif %}
</div>

<style>
  .doc-layout { display: grid; grid-template-columns: minmax(0, 1fr) 14rem; gap: var(--space-3); align-items: start; }
  .doc-toc { position: sticky; top: var(--space-3); }
  .doc-toc nav { display: flex; flex-direction: column; gap: 0.35rem; }
  .doc-toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid color-mix(in srgb, var(--text) 10%, transparent); }
  .doc-toc li { margin: 0; }
  .doc-toc a { display: block; padding: 0.25rem 0 0.25rem var(--space-2); color: var(--muted); text-decoration: none; font-size: 0.88rem; line-height: 1.35; border-left: 2px solid transparent; margin-left: -1px; }
  .doc-toc a:hover { color: var(--text); }
  .doc-toc a.active { color: var(--teal-hi); border-left-color: var(--teal); }
  .doc-toc .toc-l3 a { padding-left: calc(var(--space-2) + 0.8rem); font-size: 0.83rem; }
  @media (max-width: 880px) { .doc-layout { grid-template-columns: 1fr; } .doc-toc { display: none; } }

  /* Anchored headings clear the scroll and reveal a hover link marker. */
  .doc-prose :is(h2, h3) { scroll-margin-top: var(--space-3); }
  .doc-prose { line-height: 1.65; }
  .doc-prose h1 { font-size: 1.6rem; margin: 0 0 var(--space-2); }
  .doc-prose h2 { font-size: 1.25rem; margin: var(--space-4) 0 var(--space-2); padding-top: var(--space-2); border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent); }
  .doc-prose h3 { font-size: 1.05rem; margin: var(--space-3) 0 var(--space-1); }
  .doc-prose p, .doc-prose ul, .doc-prose ol, .doc-prose table { margin: 0 0 var(--space-2); }
  .doc-prose ul, .doc-prose ol { padding-left: 1.4em; }
  .doc-prose li { margin: 0.2em 0; }
  .doc-prose a { color: var(--teal-hi); }
  .doc-prose code { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.9em; background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 4px; }
  .doc-prose pre { background: var(--surface-2); padding: var(--space-2); border-radius: 8px; overflow-x: auto; }
  .doc-prose pre code { background: none; padding: 0; }
  .doc-prose table { border-collapse: collapse; width: 100%; }
  .doc-prose th, .doc-prose td { text-align: left; padding: 0.4em 0.6em; border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent); vertical-align: top; }
</style>

<script>
  // Scrollspy: highlight the ToC link for the section currently in view.
  (() => {
    const links = new Map();
    for (const a of document.querySelectorAll(".doc-toc a")) {
      links.set(a.getAttribute("href").slice(1), a);
    }
    if (!links.size) return;
    const heads = [...document.querySelectorAll(".doc-prose h2, .doc-prose h3")].filter(
      (h) => h.id && links.has(h.id)
    );
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            for (const a of links.values()) a.classList.remove("active");
            links.get(e.target.id)?.classList.add("active");
          }
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 }
    );
    for (const h of heads) obs.observe(h);
  })();
</script>
{% endblock %}
