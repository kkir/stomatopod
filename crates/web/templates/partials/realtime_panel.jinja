{# Inner real-time panel, htmx-swapped into #rt-panel every 10s. #}
<div class="card hero mb-2">
  <div class="hero-stats">
    <div class="stat">
      <div class="label">Active Sessions</div>
      <div class="value">{{ rt.active_sessions }}</div>
    </div>
    <div class="stat">
      <div class="label">Pageviews / min</div>
      <div class="value">{{ "%.1f" | format(rt.pageviews_per_minute) }}</div>
    </div>
    <div class="stat">
      <div class="label">Window</div>
      <div class="value">30m</div>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="section-header"><h2>Active Pages</h2></div>
    <table>
      <thead>
        <tr>
          <th>Page</th>
          <th>Active</th>
          <th>%</th>
        </tr>
      </thead>
      <tbody>
        {% for p in rt.top_pages %}
        <tr>
          <td class="cell-truncate">{{ p.url }}</td>
          <td>{{ p.active_sessions }}</td>
          <td>
            <div class="bar-cell">
              <div class="bar" style="--w:{{ [p.pct, 100] | min }}%"></div>
              {{ "%.1f" | format(p.pct) }}%
            </div>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3" class="empty-cell">No active sessions</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="section-header"><h2>Recent Events</h2></div>
    <table>
      <thead>
        <tr>
          <th>Event</th>
          <th>Page</th>
          <th>Ago</th>
        </tr>
      </thead>
      <tbody>
        {% for e in rt.recent_events %}
        <tr>
          <td>{{ e.name }}</td>
          <td class="cell-truncate">{{ e.url }}</td>
          <td>{{ e.seconds_ago }}s</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3" class="empty-cell">No recent events</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
