{% extends "base.jinja" %} {% block title %}Funnels — {{ site.name }}{% endblock
%} {% block content %}
<div class="page-head">
  <h1 class="page-title" style="view-transition-name: s-{{ site.id }}">
    {{ site.name }}
  </h1>
</div>

<div class="tabs">
  <a href="/app/sites/{{ site.id }}?range={{ range }}">Overview</a>
  <a href="/app/sites/{{ site.id }}/events?range={{ range }}">Events</a>
  <a href="/app/sites/{{ site.id }}/funnels?range={{ range }}" class="active"
    >Funnels</a
  >
  <a href="/app/sites/{{ site.id }}/keys?range={{ range }}">API Keys</a>
  <a href="/app/sites/{{ site.id }}/settings?range={{ range }}">Settings</a>
</div>

{% if result %}
<!-- Funnel result view -->
<div class="card mb-3">
  <h2 class="mb-2">{{ funnel.name }}</h2>
  <div class="funnel">
    {% for step in result.steps %} {% set bar_height = (step.conversion_rate *
    180) | int %}
    <div class="funnel-step">
      <div class="funnel-rate">
        {{ "%.0f" | format(step.conversion_rate * 100) }}%
      </div>
      <div class="funnel-bar" style="--h:{{ bar_height }}px"></div>
      <div class="funnel-name">{{ step.name }}</div>
      <div class="funnel-count">{{ step.sessions }}</div>
    </div>
    {% endfor %}
  </div>
</div>
<a href="/app/sites/{{ site.id }}/funnels" class="btn btn-ghost"
  >← All Funnels</a
>
{% else %}

<!-- Funnel list + create form -->
{% if funnels %}
<div class="list mb-3">
  {% for f in funnels %}
  <a
    href="/app/sites/{{ site.id }}/funnels/{{ f.id }}?range={{ range }}"
    class="card card-link"
  >
    <span class="item-title">{{ f.name }}</span>
    <span class="item-arrow">View →</span>
  </a>
  {% endfor %}
</div>
{% endif %}

<div class="card">
  <h2 class="mb-2">Create Funnel</h2>
  <form method="post" action="/app/sites/{{ site.id }}/funnels" id="funnel-form" onsubmit="fbSerialize()">
    <div class="field">
      <label for="funnel-name">Funnel Name</label>
      <input id="funnel-name" name="name" placeholder="e.g. Signup Flow" required autocomplete="off" />
    </div>
    <label style="display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:8px">Steps</label>
    <div class="fb-steps" id="fb-steps"></div>
    <button type="button" class="btn btn-ghost fb-add-step-btn" id="fb-add" onclick="fbAddStep()">+ Add Step</button>
    <input type="hidden" name="steps_json" id="fb-json" />
    <button type="submit" class="btn btn-primary">Create Funnel</button>
  </form>
</div>

<script>
(function () {
  var FIELDS = [
    ['url','URL'],['referrer','Referrer'],['country','Country'],
    ['browser','Browser'],['os','OS'],['device_type','Device'],
    ['utm_source','UTM Source'],['utm_medium','UTM Medium'],
    ['utm_campaign','UTM Campaign'],['event_name','Event Name'],
  ];
  var OPS = [
    ['eq','is'],['not_eq','is not'],['contains','contains'],['starts_with','starts with'],
  ];

  var steps = [
    {name:'', event_name:'pageview', filters:[]},
    {name:'', event_name:'', filters:[]},
  ];

  function e(s) {
    return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function selOpts(opts, val) {
    return opts.map(function(o){
      return '<option value="'+e(o[0])+'"'+(o[0]===val?' selected':'')+'>'+e(o[1])+'</option>';
    }).join('');
  }

  function renderFilter(si, fi, f) {
    return '<div class="fb-filter-row" id="fbfr-'+si+'-'+fi+'">'
      +'<select onchange="fbFld('+si+','+fi+',\'field\',this.value)">'+selOpts(FIELDS,f.field)+'</select>'
      +'<select onchange="fbFld('+si+','+fi+',\'op\',this.value)">'+selOpts(OPS,f.op)+'</select>'
      +'<input value="'+e(f.value)+'" placeholder="value" oninput="fbFld('+si+','+fi+',\'value\',this.value)" />'
      +'<button type="button" class="fb-remove-btn" onclick="fbRmFilter('+si+','+fi+')" title="Remove filter">×</button>'
      +'</div>';
  }

  function renderStep(si, step) {
    var canRemove = steps.length > 2;
    var html = '<div class="fb-step" id="fbs-'+si+'">'
      +'<div class="fb-step-header">'
      +'<span class="fb-step-num">Step '+(si+1)+'</span>'
      +(canRemove ? '<button type="button" class="fb-remove-btn" onclick="fbRmStep('+si+')" title="Remove step">×</button>' : '')
      +'</div>'
      +'<div class="fb-step-body">'
      +'<div class="fb-fields">'
      +'<div class="field"><label>Label</label>'
      +'<input value="'+e(step.name)+'" placeholder="e.g. Visited Homepage" oninput="fbSVal('+si+',\'name\',this.value)" required autocomplete="off" /></div>'
      +'<div class="field"><label>Event</label>'
      +'<input value="'+e(step.event_name)+'" placeholder="e.g. pageview" oninput="fbSVal('+si+',\'event_name\',this.value)" required autocomplete="off" /></div>'
      +'</div>';
    step.filters.forEach(function(f, fi) { html += renderFilter(si, fi, f); });
    html += '<button type="button" class="btn btn-ghost fb-add-filter-btn" onclick="fbAddFilter('+si+')">+ Filter</button>'
      +'</div></div>';
    return html;
  }

  function render() {
    var html = '';
    steps.forEach(function(step, si) {
      html += renderStep(si, step);
      if (si < steps.length - 1) html += '<div class="fb-connector">↓</div>';
    });
    document.getElementById('fb-steps').innerHTML = html;
  }

  window.fbAddStep = function() { steps.push({name:'',event_name:'',filters:[]}); render(); };
  window.fbRmStep = function(i) { steps.splice(i,1); render(); };
  window.fbAddFilter = function(si) { steps[si].filters.push({field:'url',op:'eq',value:''}); render(); };
  window.fbRmFilter = function(si,fi) { steps[si].filters.splice(fi,1); render(); };
  window.fbSVal = function(si,k,v) { steps[si][k]=v; };
  window.fbFld = function(si,fi,k,v) { steps[si].filters[fi][k]=v; };
  window.fbSerialize = function() {
    document.getElementById('fb-json').value = JSON.stringify(steps);
  };

  render();
})();
</script>
{% endif %} {% endblock %}
