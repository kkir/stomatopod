{% extends "base.jinja" %} {% block title %}Alerts — {{ site.name }}{% endblock
%} {% block content %}
<div class="page-head">
  <div>
    <h1 class="page-title" style="view-transition-name: s-{{ site.id }}">
      {{ site.name }}
    </h1>
    <p class="page-sub">{{ site.domain }}</p>
  </div>
  {% if sites %}
  <form method="get" action="{{ scope_path }}">
    <select name="site" onchange="this.form.submit()" aria-label="Filter by site">
      {% for s in sites %}<option value="{{ s.id }}" {% if s.id == site.id %}selected{% endif %}>{{ s.name }}</option>{% endfor %}
    </select>
  </form>
  {% endif %}
</div>

<div class="tabs">
  <a href="/app/sites/{{ site.id }}?range={{ range }}">Overview</a>
  <a href="/app/sites/{{ site.id }}/realtime">Real-time</a>
  <a href="/app/sites/{{ site.id }}/events?range={{ range }}">Events</a>
  <a href="/app/sites/{{ site.id }}/goals?range={{ range }}">Goals</a>
  <a href="/app/sites/{{ site.id }}/funnels?range={{ range }}">Funnels</a>
  <a href="/app/sites/{{ site.id }}/alerts?range={{ range }}" class="active"
    >Alerts</a
  >
  <a href="/app/sites/{{ site.id }}/keys?range={{ range }}">API Keys</a>
  <a href="/app/sites/{{ site.id }}/settings?range={{ range }}">Settings</a>
</div>

<div class="card mb-3">
  <div class="section-header"><h2>Analytics Alerts</h2></div>
  <table>
    <thead>
      <tr>
        <th>Type</th>
        <th>Threshold</th>
        <th>Window</th>
        <th>Status</th>
        <th>Last fired</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for a in alerts %}
      <tr>
        <td>{{ a.type }}{% if a.goal_event_name %} · <code>{{ a.goal_event_name }}</code>{% endif %}</td>
        <td>{{ a.threshold }}</td>
        <td>{{ a.window_minutes }}m</td>
        <td>{% if a.enabled %}enabled{% else %}disabled{% endif %}</td>
        <td>
          {% if a.last_fired %}<time class="js-local-time" datetime="{{ a.last_fired }}">{{ a.last_fired }}</time>{% else %}—{% endif %}
        </td>
        <td>
          <form
            method="post"
            action="/app/sites/{{ site.id }}/alerts/{{ a.id }}/delete"
            onsubmit="return confirm('Delete this alert?')"
          >
            <button type="submit" class="btn btn-ghost">Delete</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="6" class="empty-cell">No alerts configured</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if tested == "ok" %}
<div class="card mb-2 flash flash-ok">Test notification sent.</div>
{% elif tested == "fail" %}
<div class="card mb-2 flash flash-err">
  Test notification failed — check the channel destination and secret.
</div>
{% endif %}

<div class="card mb-3">
  <div class="section-header"><h2>Alert Channels</h2></div>
  <table>
    <thead>
      <tr>
        <th>Kind</th>
        <th>Destination</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for c in channels %}
      <tr>
        <td>{{ c.kind }}</td>
        <td class="cell-truncate">{{ c.url }}</td>
        <td class="row-actions">
          <form
            method="post"
            action="/app/sites/{{ site.id }}/channels/{{ c.id }}/test"
          >
            <button type="submit" class="btn btn-ghost">Test</button>
          </form>
          <form
            method="post"
            action="/app/sites/{{ site.id }}/channels/{{ c.id }}/delete"
            onsubmit="return confirm('Delete this channel?')"
          >
            <button type="submit" class="btn btn-ghost">Delete</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="3" class="empty-cell">No channels yet</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 class="mb-2" style="margin-top: 1rem">Add Channel</h3>
  <form method="post" action="/app/sites/{{ site.id }}/channels" class="form-row">
    <div class="field">
      <label for="ch-kind">Kind</label>
      <select id="ch-kind" name="kind">
        <option value="webhook">Webhook</option>
        <option value="slack">Slack</option>
        <option value="telegram">Telegram</option>
      </select>
    </div>
    <div class="field">
      <label for="ch-url">Destination URL / Telegram chat id</label>
      <input id="ch-url" name="url" placeholder="https://hooks… or 123456789" required autocomplete="off" />
    </div>
    <div class="field">
      <label for="ch-secret">Secret / Telegram bot token</label>
      <input id="ch-secret" name="secret" placeholder="optional (required for Telegram)" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-primary">Add Channel</button>
  </form>
</div>

<div class="card">
  <h2 class="mb-2">Create Alert</h2>
  {% if channels %}
  <form method="post" action="/app/sites/{{ site.id }}/alerts" class="form-row">
    <div class="field">
      <label for="alert-type">Type</label>
      <select id="alert-type" name="type">
        <option value="traffic_spike">Traffic spike</option>
        <option value="traffic_drop">Traffic drop</option>
        <option value="goal_threshold">Goal threshold</option>
        <option value="new_referrer_spike">Referrer spike</option>
      </select>
    </div>
    <div class="field">
      <label for="alert-threshold">Threshold</label>
      <input id="alert-threshold" name="threshold" type="number" step="any" value="200" required />
    </div>
    <div class="field">
      <label for="alert-window">Window (min)</label>
      <input id="alert-window" name="window_minutes" type="number" value="60" />
    </div>
    <div class="field">
      <label for="alert-goal">Goal event (goal threshold only)</label>
      <input id="alert-goal" name="goal_event_name" placeholder="e.g. user_signed_up" autocomplete="off" />
    </div>
    <div class="field">
      <label for="alert-channel">Channel</label>
      <select id="alert-channel" name="channel_id">
        {% for c in channels %}
        <option value="{{ c.id }}">{{ c.kind }} · {{ c.url }}</option>
        {% endfor %}
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Create Alert</button>
  </form>
  {% else %}
  <p class="empty-cell">
    No alert channels configured for this site. An alert channel (webhook or
    Slack) must exist before you can create an alert.
  </p>
  {% endif %}
</div>

<script>
  (() => {
    for (const el of document.querySelectorAll(".js-local-time")) {
      const iso = el.getAttribute("datetime");
      if (!iso) continue;
      const dt = new Date(iso);
      if (!Number.isNaN(dt.getTime())) el.textContent = dt.toLocaleString();
    }
  })();
</script>
{% endblock %}
