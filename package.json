{
  "name": "stomatopod-marketing-assets",
  "private": true,
  "version": "0.1.0",
  "description": "Marketing site asset pipeline for Stomatopod (Tailwind CSS + vendored anime.js).",
  "scripts": {
    "build:assets": "tailwindcss -i ./assets/marketing.css -o ./assets/dist/marketing.css --minify",
    "watch:assets": "tailwindcss -i ./assets/marketing.css -o ./assets/dist/marketing.css --watch",
    "vendor:anime": "cp ./node_modules/animejs/lib/anime.min.js ./assets/vendor/anime.min.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "animejs": "^3.2.1",
    "tailwindcss": "^3.4.17"
  }
}
