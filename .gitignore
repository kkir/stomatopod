/target
/data
# `mise dev` runs `dx serve` from crates/web, so the embedded store's relative
# `data_dir = "./data"` lands here instead of at the repo root.
/crates/web/data
*.mmdb
stomatopod.toml
!tests/e2e/stomatopod.toml
.env
*.log
node_modules/
assets/dist/
# Dioxus fullstack build output (client bundle + server binary), rebuilt in CI /
# Docker via `dx build --platform web`. Covered by `/target` above but called
# out here for clarity.
/target/dx/
# Compiled Tailwind output, regenerated from crates/web/tailwind.css by
# `dx serve`/`dx build`. The source is tracked; this artifact is not.
/crates/web/assets/tailwind.css
.DS_Store
